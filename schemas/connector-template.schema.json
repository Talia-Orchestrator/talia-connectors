{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Talia generic connector template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "template"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "transport_kind", "description_en", "documentation_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "transport_kind": {"enum": ["stdio", "streamable-http"]},
        "description_en": {"type": "string", "maxLength": 4000},
        "documentation_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "command_hint": {"type": "string", "maxLength": 512},
        "args": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 512}},
        "url_hint": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "oneOf": [
        {
          "properties": {"transport_kind": {"const": "stdio"}},
          "required": ["command_hint", "args"],
          "not": {"required": ["url_hint"]}
        },
        {
          "properties": {"transport_kind": {"const": "streamable-http"}},
          "required": ["url_hint"],
          "not": {"anyOf": [{"required": ["command_hint"]}, {"required": ["args"]}]}
        }
      ]
    }
  }
}
